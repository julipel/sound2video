[
  {
    "first": 1,
    "last": 11,
    "text": "",
    "group": 0,
    "start": 0.0,
    "end": 6.048
  },
  {
    "first": 12,
    "last": 23,
    "text": "Одна из самых популярных линеек SonoScape",
    "group": 1,
    "start": 6.048,
    "end": 11.678
  },
  {
    "first": 24,
    "last": 29,
    "text": "Компактный и стильный",
    "group": 2,
    "start": 11.678,
    "end": 14.348
  },
  {
    "first": 30,
    "last": 36,
    "text": "Легкий и удобный в транспортировке",
    "group": 3,
    "start": 14.348,
    "end": 17.809
  },
  {
    "first": 37,
    "last": 49,
    "text": "От 2 до З портов в зависимости модели",
    "group": 4,
    "start": 17.809,
    "end": 24.524
  },
  {
    "first": 50,
    "last": 57,
    "text": "Модель ЕЗ оснащена З портами",
    "group": 5,
    "start": 24.524,
    "end": 28.362
  },
  {
    "first": 58,
    "last": 58,
    "text": "",
    "group": 6,
    "start": 28.362,
    "end": 28.946
  },
  {
    "first": 59,
    "last": 65,
    "text": "Все интерфейсы (порты ввода/вывода) на борту",
    "group": 7,
    "start": 28.946,
    "end": 32.491
  },
  {
    "first": 66,
    "last": 76,
    "text": "Открывается простым движением",
    "group": 8,
    "start": 32.491,
    "end": 38.121
  },
  {
    "first": 77,
    "last": 86,
    "text": "Регулируемый угол наклона дисплея",
    "group": 9,
    "start": 38.121,
    "end": 43.001
  },
  {
    "first": 87,
    "last": 92,
    "text": "",
    "group": 10,
    "start": 43.001,
    "end": 45.963
  },
  {
    "first": 93,
    "last": 101,
    "text": "Нажмите кнопку <Patient>",
    "group": 11,
    "start": 45.963,
    "end": 50.467
  },
  {
    "first": 102,
    "last": 106,
    "text": "Введите данные нового пациента",
    "group": 12,
    "start": 50.467,
    "end": 53.053
  },
  {
    "first": 107,
    "last": 114,
    "text": "Ю-пациента можно создать вручную или автоматически",
    "group": 13,
    "start": 53.053,
    "end": 57.099
  },
  {
    "first": 115,
    "last": 118,
    "text": "Затем выберите тип исследования",
    "group": 14,
    "start": 57.099,
    "end": 59.226
  },
  {
    "first": 119,
    "last": 122,
    "text": "(абдоминальное/кардиология/и др.)",
    "group": 15,
    "start": 59.226,
    "end": 61.061
  },
  {
    "first": 123,
    "last": 126,
    "text": "И заполните информацию об исследовании",
    "group": 16,
    "start": 61.061,
    "end": 62.938
  },
  {
    "first": 127,
    "last": 131,
    "text": "Также можно выбрать пациента из «списка пациентов»",
    "group": 17,
    "start": 62.938,
    "end": 65.691
  },
  {
    "first": 132,
    "last": 138,
    "text": "или из рабочего списка DICOM",
    "group": 18,
    "start": 65.691,
    "end": 69.236
  },
  {
    "first": 139,
    "last": 143,
    "text": "После ввода информации о пациенте",
    "group": 19,
    "start": 69.236,
    "end": 71.405
  },
  {
    "first": 144,
    "last": 150,
    "text": "Мы начинаем обследование",
    "group": 20,
    "start": 71.405,
    "end": 75.117
  },
  {
    "first": 151,
    "last": 161,
    "text": "Например, выбираем предустановку ”щитовидная железа”",
    "group": 21,
    "start": 75.117,
    "end": 80.581
  },
  {
    "first": 162,
    "last": 167,
    "text": "И переходим в В-режим",
    "group": 22,
    "start": 80.581,
    "end": 83.417
  },
  {
    "first": 168,
    "last": 172,
    "text": "Область изображения отображается посередине",
    "group": 23,
    "start": 83.417,
    "end": 86.128
  },
  {
    "first": 173,
    "last": 179,
    "text": "Настройки параметров расположены внизу",
    "group": 24,
    "start": 86.128,
    "end": 89.631
  },
  {
    "first": 180,
    "last": 185,
    "text": "Мы можем повернуть регулятор для настройки",
    "group": 25,
    "start": 89.631,
    "end": 92.551
  },
  {
    "first": 186,
    "last": 190,
    "text": "Или нажать кнопку для смены регулируемого параметра",
    "group": 26,
    "start": 92.551,
    "end": 95.012
  },
  {
    "first": 191,
    "last": 200,
    "text": "И нажать <Next> для перехода на 2ю страницу параметров",
    "group": 27,
    "start": 95.012,
    "end": 99.766
  },
  {
    "first": 201,
    "last": 208,
    "text": "Рассмотрим основные параметры В-режима",
    "group": 28,
    "start": 99.766,
    "end": 103.77
  },
  {
    "first": 209,
    "last": 212,
    "text": "Включая <Gain> (”Усиление”)",
    "group": 29,
    "start": 103.77,
    "end": 105.856
  },
  {
    "first": 213,
    "last": 219,
    "text": "Увеличивает или уменьшает яркость изображения",
    "group": 30,
    "start": 105.856,
    "end": 109.359
  },
  {
    "first": 220,
    "last": 222,
    "text": "Частота",
    "group": 31,
    "start": 109.359,
    "end": 110.986
  },
  {
    "first": 223,
    "last": 226,
    "text": "Больше частота — выше разрешение",
    "group": 32,
    "start": 110.986,
    "end": 113.113
  },
  {
    "first": 227,
    "last": 232,
    "text": "Ниже частота — лучше проникновение",
    "group": 33,
    "start": 113.113,
    "end": 116.033
  },
  {
    "first": 233,
    "last": 241,
    "text": "Подавление зернистости и подчеркивание контуров структур",
    "group": 34,
    "start": 116.033,
    "end": 120.579
  },
  {
    "first": 242,
    "last": 245,
    "text": "”Карты серого”",
    "group": 35,
    "start": 120.579,
    "end": 122.539
  },
  {
    "first": 246,
    "last": 250,
    "text": "Различные уровни яркости серого",
    "group": 36,
    "start": 122.539,
    "end": 125.083
  },
  {
    "first": 251,
    "last": 253,
    "text": "Динамический диапазон",
    "group": 37,
    "start": 125.083,
    "end": 126.293
  },
  {
    "first": 254,
    "last": 257,
    "text": "Высокий для большей детализации",
    "group": 38,
    "start": 126.293,
    "end": 128.378
  },
  {
    "first": 258,
    "last": 263,
    "text": "Низкий для большей контрастности",
    "group": 39,
    "start": 128.378,
    "end": 131.256
  },
  {
    "first": 264,
    "last": 265,
    "text": "Chroma",
    "group": 40,
    "start": 131.256,
    "end": 132.341
  },
  {
    "first": 266,
    "last": 268,
    "text": "Псевдоколоризация",
    "group": 41,
    "start": 132.341,
    "end": 134.176
  },
  {
    "first": 269,
    "last": 274,
    "text": "И другие основные кнопки параметров",
    "group": 42,
    "start": 134.176,
    "end": 137.22
  },
  {
    "first": 275,
    "last": 280,
    "text": "Такие как <depth> (”глубина\"), <focus> (”фокус”), <zoom> (”увеличение\")",
    "group": 43,
    "start": 137.22,
    "end": 140.14
  },
  {
    "first": 281,
    "last": 286,
    "text": "Также доступны на панели управления",
    "group": 44,
    "start": 140.14,
    "end": 142.893
  },
  {
    "first": 287,
    "last": 293,
    "text": "Для быстрой и легкой регулировки",
    "group": 45,
    "start": 142.893,
    "end": 146.313
  },
  {
    "first": 294,
    "last": 299,
    "text": "Есть З способа увеличения изображения",
    "group": 46,
    "start": 146.313,
    "end": 149.691
  },
  {
    "first": 300,
    "last": 305,
    "text": "Поверните ручку ”Zoom” для увеличения изображения",
    "group": 47,
    "start": 149.691,
    "end": 152.611
  },
  {
    "first": 306,
    "last": 311,
    "text": "Нажмите кнопку ”Zoom” для увеличения определенной области",
    "group": 48,
    "start": 152.611,
    "end": 155.28
  },
  {
    "first": 312,
    "last": 318,
    "text": "Или нажмите кнопку <z> для полноэкранного изображения",
    "group": 49,
    "start": 155.28,
    "end": 158.992
  },
  {
    "first": 319,
    "last": 319,
    "text": "",
    "group": 50,
    "start": 158.992,
    "end": 159.743
  },
  {
    "first": 320,
    "last": 328,
    "text": "Получив изображение с необходимыми параметрами",
    "group": 51,
    "start": 159.743,
    "end": 163.872
  },
  {
    "first": 329,
    "last": 333,
    "text": "Нажмите Freeze для перехода в режим кинопетли",
    "group": 52,
    "start": 163.872,
    "end": 166.583
  },
  {
    "first": 334,
    "last": 339,
    "text": "Вращайте трекбол для выбора оптимального кадра",
    "group": 53,
    "start": 166.583,
    "end": 169.503
  },
  {
    "first": 340,
    "last": 346,
    "text": "Внизу здесь также отображаются соответствующие параметры",
    "group": 54,
    "start": 169.503,
    "end": 173.048
  },
  {
    "first": 347,
    "last": 356,
    "text": "Которые вы можете настроить",
    "group": 55,
    "start": 173.048,
    "end": 177.928
  },
  {
    "first": 357,
    "last": 359,
    "text": "",
    "group": 56,
    "start": 177.928,
    "end": 179.513
  },
  {
    "first": 360,
    "last": 367,
    "text": "Нажмите кнопку <CFM>",
    "group": 57,
    "start": 179.513,
    "end": 183.684
  },
  {
    "first": 368,
    "last": 374,
    "text": "Чтобы включить режим ЦДК",
    "group": 58,
    "start": 183.684,
    "end": 186.812
  },
  {
    "first": 375,
    "last": 378,
    "text": "Также вы можете включить режим SR FIow",
    "group": 59,
    "start": 186.812,
    "end": 188.897
  },
  {
    "first": 379,
    "last": 395,
    "text": "Для улучшения определения низкоскоростного кровотока",
    "group": 60,
    "start": 188.897,
    "end": 197.364
  },
  {
    "first": 396,
    "last": 410,
    "text": "В режиме ЦДК на экране появляется рамка",
    "group": 61,
    "start": 197.364,
    "end": 205.205
  },
  {
    "first": 411,
    "last": 416,
    "text": "Перемещайте рамку трекболом",
    "group": 62,
    "start": 205.205,
    "end": 208.041
  },
  {
    "first": 417,
    "last": 442,
    "text": "На>кмите SET и перемещайте трекбол для изменения размера рамки",
    "group": 63,
    "start": 208.041,
    "end": 220.762
  },
  {
    "first": 443,
    "last": 449,
    "text": "Чтобы зафиксировать размер рамки нажмите SET еще раз",
    "group": 64,
    "start": 220.762,
    "end": 224.474
  },
  {
    "first": 450,
    "last": 456,
    "text": "соответствующие параметры режима ЦДК отображаются внизу",
    "group": 65,
    "start": 224.474,
    "end": 227.894
  },
  {
    "first": 457,
    "last": 463,
    "text": "Параметры регулируются тем же способом",
    "group": 66,
    "start": 227.894,
    "end": 231.481
  },
  {
    "first": 464,
    "last": 471,
    "text": "Нажмите для включения режима импульсно-волнового допплера",
    "group": 67,
    "start": 231.481,
    "end": 235.736
  },
  {
    "first": 472,
    "last": 479,
    "text": "Он доступен в В-режиме или ЦДК",
    "group": 68,
    "start": 235.736,
    "end": 239.698
  },
  {
    "first": 480,
    "last": 487,
    "text": "Контрольный объем появляется в центре изображения",
    "group": 69,
    "start": 239.698,
    "end": 243.577
  },
  {
    "first": 488,
    "last": 494,
    "text": "Используйте трекбол для перемещения контрольного объема в нужную позицию",
    "group": 70,
    "start": 243.577,
    "end": 246.872
  },
  {
    "first": 495,
    "last": 501,
    "text": "Для изменения размера нажмите SET",
    "group": 71,
    "start": 246.872,
    "end": 250.625
  },
  {
    "first": 502,
    "last": 514,
    "text": "перемещайте трекбол чтобы изменить размер контрольного объема",
    "group": 72,
    "start": 250.625,
    "end": 257.215
  },
  {
    "first": 515,
    "last": 523,
    "text": "Нажмите SET еще раз для подтверждения изменений",
    "group": 73,
    "start": 257.215,
    "end": 261.511
  },
  {
    "first": 524,
    "last": 530,
    "text": "Затем нажмите <UPDATE> для активации режима Р УМ",
    "group": 74,
    "start": 261.511,
    "end": 264.931
  },
  {
    "first": 531,
    "last": 534,
    "text": "Чтобы скорректировать положение контрольного объема в сосуде, перемещайте трекбол",
    "group": 75,
    "start": 264.931,
    "end": 267.184
  },
  {
    "first": 535,
    "last": 539,
    "text": "Аппарат выйдет из режима развертки и перейдёт в «живой» В-режим",
    "group": 76,
    "start": 267.184,
    "end": 269.561
  },
  {
    "first": 540,
    "last": 544,
    "text": "и вы можете изменить положение контрольного объема",
    "group": 77,
    "start": 269.561,
    "end": 271.772
  },
  {
    "first": 545,
    "last": 547,
    "text": "на изображении в реальном времени.",
    "group": 78,
    "start": 271.772,
    "end": 273.398
  },
  {
    "first": 548,
    "last": 550,
    "text": "Допплеровский режим при этом останавливается.",
    "group": 79,
    "start": 273.398,
    "end": 275.108
  },
  {
    "first": 551,
    "last": 553,
    "text": "Когда вы остановите трекбол,",
    "group": 80,
    "start": 275.108,
    "end": 276.276
  },
  {
    "first": 554,
    "last": 556,
    "text": "снова автоматически запускается допплеровский спектр.",
    "group": 81,
    "start": 276.276,
    "end": 278.028
  },
  {
    "first": 557,
    "last": 561,
    "text": "Для запуска триплексного режима нажмите функциональную кнопку ”Одноврем\",",
    "group": 82,
    "start": 278.028,
    "end": 280.572
  },
  {
    "first": 562,
    "last": 567,
    "text": "чтобы выбрать пункт меню, и затем поверните ручку, чтобы включить режим триплекса",
    "group": 83,
    "start": 280.572,
    "end": 283.492
  },
  {
    "first": 568,
    "last": 571,
    "text": "кроме отображаемых внизу параметров режима Р УМ",
    "group": 84,
    "start": 283.492,
    "end": 285.619
  },
  {
    "first": 572,
    "last": 580,
    "text": "используйте кнопки и",
    "group": 85,
    "start": 285.619,
    "end": 289.831
  },
  {
    "first": 581,
    "last": 582,
    "text": "Для регулировки, соответственно, положения базовой линии",
    "group": 86,
    "start": 289.831,
    "end": 291.166
  },
  {
    "first": 583,
    "last": 586,
    "text": "и шкалы скоростей допплеровского спектра",
    "group": 87,
    "start": 291.166,
    "end": 292.751
  },
  {
    "first": 587,
    "last": 588,
    "text": "Нажмите Freeze",
    "group": 88,
    "start": 292.751,
    "end": 294.127
  },
  {
    "first": 589,
    "last": 595,
    "text": "После того как вы получили оптимальный спектр",
    "group": 89,
    "start": 294.127,
    "end": 297.672
  },
  {
    "first": 596,
    "last": 601,
    "text": "Для автоматической оптимизации изображения",
    "group": 90,
    "start": 297.672,
    "end": 300.3
  },
  {
    "first": 602,
    "last": 607,
    "text": "просто нажмите <Auto>",
    "group": 91,
    "start": 300.3,
    "end": 303.303
  },
  {
    "first": 608,
    "last": 616,
    "text": "Это работает В-режиме, ЦДК и PW",
    "group": 92,
    "start": 303.303,
    "end": 307.808
  },
  {
    "first": 617,
    "last": 627,
    "text": "это экономит время полной настройки параметров",
    "group": 93,
    "start": 307.808,
    "end": 313.688
  },
  {
    "first": 628,
    "last": 634,
    "text": "Аппараты серии Е также оснащены",
    "group": 94,
    "start": 313.688,
    "end": 317.108
  },
  {
    "first": 635,
    "last": 642,
    "text": "практичными функциями для эффективной работы",
    "group": 95,
    "start": 317.108,
    "end": 320.987
  },
  {
    "first": 643,
    "last": 646,
    "text": "такими как SonoHe1p",
    "group": 96,
    "start": 320.987,
    "end": 322.906
  },
  {
    "first": 647,
    "last": 653,
    "text": "Который даёт вам рекомендации по проведению обследования",
    "group": 97,
    "start": 322.906,
    "end": 326.326
  },
  {
    "first": 654,
    "last": 658,
    "text": "SonoHe1p - это учебник, показывающий расположение датчика,\nанатомические иллюстрации и стандартные примеры ультразвуковых изображений.",
    "group": 98,
    "start": 326.326,
    "end": 328.829
  },
  {
    "first": 659,
    "last": 663,
    "text": "В качестве полезного справочника,\nна который могли бы положиться менее опытные клиницисты,",
    "group": 99,
    "start": 328.829,
    "end": 331.456
  },
  {
    "first": 664,
    "last": 672,
    "text": "включая печень, почки, сердце, молочные железы,\nщитовидную железу, акушерство, сосуды и т.д.",
    "group": 100,
    "start": 331.456,
    "end": 336.211
  },
  {
    "first": 673,
    "last": 680,
    "text": "Вы можете добавить свои комментарии к изображению",
    "group": 101,
    "start": 336.211,
    "end": 340.215
  },
  {
    "first": 681,
    "last": 687,
    "text": "Нажатием кнопки Annotation",
    "group": 102,
    "start": 340.215,
    "end": 343.426
  },
  {
    "first": 688,
    "last": 695,
    "text": "Или выбрать их из библиотеки аннотаций",
    "group": 103,
    "start": 343.426,
    "end": 347.722
  },
  {
    "first": 696,
    "last": 705,
    "text": "Для каждого вида обследования предусмотрена своя библиотека аннотаций",
    "group": 104,
    "start": 347.722,
    "end": 352.352
  },
  {
    "first": 706,
    "last": 713,
    "text": "Нажмите кнопку BodyMark и выберите нужную пиктограмму",
    "group": 105,
    "start": 352.352,
    "end": 356.523
  },
  {
    "first": 714,
    "last": 717,
    "text": "Поверните регулятор Body Mark",
    "group": 106,
    "start": 356.523,
    "end": 358.441
  },
  {
    "first": 718,
    "last": 722,
    "text": "Для изменения угла маркера датчика",
    "group": 107,
    "start": 358.441,
    "end": 361.069
  },
  {
    "first": 723,
    "last": 732,
    "text": "И двигайте трекбол чтобы поместить маркер датчика в нужное место",
    "group": 108,
    "start": 361.069,
    "end": 365.991
  },
  {
    "first": 733,
    "last": 738,
    "text": "Переходим к измерениям и расчётам",
    "group": 109,
    "start": 365.991,
    "end": 369.119
  },
  {
    "first": 739,
    "last": 744,
    "text": "При выборе Caliper для базовых измерений",
    "group": 110,
    "start": 369.119,
    "end": 372.163
  },
  {
    "first": 745,
    "last": 751,
    "text": "Список измерений появится в левой части экрана",
    "group": 111,
    "start": 372.163,
    "end": 375.709
  },
  {
    "first": 752,
    "last": 755,
    "text": "Щелкните на нужное измерение",
    "group": 112,
    "start": 375.709,
    "end": 377.46
  },
  {
    "first": 756,
    "last": 760,
    "text": "измеритель появится в области изображения",
    "group": 113,
    "start": 377.46,
    "end": 380.213
  },
  {
    "first": 761,
    "last": 763,
    "text": "трекболом установите курсор и нажмите Set,",
    "group": 114,
    "start": 380.213,
    "end": 381.548
  },
  {
    "first": 764,
    "last": 766,
    "text": "на экране появится второй курсор, переместите",
    "group": 115,
    "start": 381.548,
    "end": 383.008
  },
  {
    "first": 767,
    "last": 769,
    "text": "второй указатель в желаемое положение, снова нажмите SET",
    "group": 116,
    "start": 383.008,
    "end": 384.593
  },
  {
    "first": 770,
    "last": 782,
    "text": "По завершению всех шагов результаты отобразятся в окне результатов измерений",
    "group": 117,
    "start": 384.593,
    "end": 390.932
  },
  {
    "first": 783,
    "last": 785,
    "text": "Нажмите клавишу",
    "group": 118,
    "start": 390.932,
    "end": 392.559
  },
  {
    "first": 786,
    "last": 789,
    "text": "отображаются специальные измерения",
    "group": 119,
    "start": 392.559,
    "end": 394.603
  },
  {
    "first": 790,
    "last": 793,
    "text": "и расчёты для каждой области применения.",
    "group": 120,
    "start": 394.603,
    "end": 396.479
  },
  {
    "first": 794,
    "last": 804,
    "text": "Вы можете выбрать нужное вам исследование",
    "group": 121,
    "start": 396.479,
    "end": 401.943
  },
  {
    "first": 805,
    "last": 823,
    "text": "",
    "group": 122,
    "start": 401.943,
    "end": 411.411
  },
  {
    "first": 824,
    "last": 830,
    "text": "Результаты специальных измерений",
    "group": 123,
    "start": 411.411,
    "end": 414.873
  },
  {
    "first": 831,
    "last": 837,
    "text": "попадают в отчет автоматически по их завершению",
    "group": 124,
    "start": 414.873,
    "end": 418.46
  },
  {
    "first": 838,
    "last": 844,
    "text": "Получив требуемый кадр и кинопетлю",
    "group": 125,
    "start": 418.46,
    "end": 421.755
  },
  {
    "first": 845,
    "last": 848,
    "text": "или закончив работу с аннотациями",
    "group": 126,
    "start": 421.755,
    "end": 424.174
  },
  {
    "first": 849,
    "last": 852,
    "text": "маркерами тела и вычислениями",
    "group": 127,
    "start": 424.174,
    "end": 426.051
  },
  {
    "first": 853,
    "last": 859,
    "text": "Вы можете нажать клавиши Image или Cine",
    "group": 128,
    "start": 426.051,
    "end": 429.638
  },
  {
    "first": 860,
    "last": 864,
    "text": "изображения и кинопетли будут сохранены на жёстком диске аппарата",
    "group": 129,
    "start": 429.638,
    "end": 431.765
  },
  {
    "first": 865,
    "last": 868,
    "text": "их миниатюры будут показаны в правой части экрана",
    "group": 130,
    "start": 431.765,
    "end": 433.808
  },
  {
    "first": 869,
    "last": 873,
    "text": "Выберите изображение указателем (клавиша Pointer)",
    "group": 131,
    "start": 433.808,
    "end": 436.311
  },
  {
    "first": 874,
    "last": 878,
    "text": "Для просмотра и управления им",
    "group": 132,
    "start": 436.311,
    "end": 438.897
  },
  {
    "first": 879,
    "last": 883,
    "text": "Щелкнув по этим функциональным элементам",
    "group": 133,
    "start": 438.897,
    "end": 441.358
  },
  {
    "first": 884,
    "last": 888,
    "text": "по завершению обследования",
    "group": 134,
    "start": 441.358,
    "end": 444.194
  },
  {
    "first": 889,
    "last": 892,
    "text": "Нажмите клавишу Report",
    "group": 135,
    "start": 444.194,
    "end": 446.029
  },
  {
    "first": 893,
    "last": 897,
    "text": "для просмотра результатов специальных измерений и расчётов",
    "group": 136,
    "start": 446.029,
    "end": 448.406
  },
  {
    "first": 898,
    "last": 903,
    "text": "Нажмите ”Summary” и введите заключение",
    "group": 137,
    "start": 448.406,
    "end": 451.743
  },
  {
    "first": 904,
    "last": 918,
    "text": "Выберите изображения для прикрепления к отчету",
    "group": 138,
    "start": 451.743,
    "end": 459.0
  },
  {
    "first": 919,
    "last": 926,
    "text": "Воспользуйтесь предварительным просмотром по завершению",
    "group": 139,
    "start": 459.0,
    "end": 462.921
  },
  {
    "first": 927,
    "last": 932,
    "text": "Затем перешлите отчет по DICOM",
    "group": 140,
    "start": 462.921,
    "end": 466.091
  },
  {
    "first": 933,
    "last": 946,
    "text": "или нажмите End Ехат для сохранения на жестком диске сканера",
    "group": 141,
    "start": 466.091,
    "end": 472.806
  },
  {
    "first": 947,
    "last": 956,
    "text": "При нажатии кнопки Setup в левом нижнем углу клавиатуры",
    "group": 142,
    "start": 472.806,
    "end": 478.103
  },
  {
    "first": 957,
    "last": 964,
    "text": "Вы переходите в меню настроек аппарата",
    "group": 143,
    "start": 478.103,
    "end": 481.898
  },
  {
    "first": 965,
    "last": 978,
    "text": "Настраиваемые параметры отображаются слева",
    "group": 144,
    "start": 481.898,
    "end": 488.947
  },
  {
    "first": 979,
    "last": 984,
    "text": "Сперва идут общие настройки системы",
    "group": 145,
    "start": 488.947,
    "end": 492.075
  },
  {
    "first": 985,
    "last": 989,
    "text": "Они включают 4 вкладки:",
    "group": 146,
    "start": 492.075,
    "end": 494.536
  },
  {
    "first": 990,
    "last": 1000,
    "text": "<Общ.инф> <Дисплей> <Сохранить> и <Биопсия>",
    "group": 147,
    "start": 494.536,
    "end": 499.791
  },
  {
    "first": 1001,
    "last": 1008,
    "text": "на вкладке Общ.инф можно настроить поля",
    "group": 148,
    "start": 499.791,
    "end": 504.087
  },
  {
    "first": 1009,
    "last": 1017,
    "text": "такие ”Название клиники” ”Язык”, ”Время” и др.",
    "group": 149,
    "start": 504.087,
    "end": 508.55
  },
  {
    "first": 1018,
    "last": 1024,
    "text": "на вкладке ”Дисплей” можно настроить",
    "group": 150,
    "start": 508.55,
    "end": 512.011
  },
  {
    "first": 1025,
    "last": 1034,
    "text": "параметры дисплея по своему усмотрению",
    "group": 151,
    "start": 512.011,
    "end": 516.891
  },
  {
    "first": 1035,
    "last": 1047,
    "text": "вкладка ' Сохранить“ используется для изменения ДАИтеАЬНОСТИ сохраняемой кинопетли",
    "group": 152,
    "start": 516.891,
    "end": 523.69
  },
  {
    "first": 1048,
    "last": 1059,
    "text": "А таюке для назначения функций настраиваемых клавиш Р 1 Р2 F3 F4",
    "group": 153,
    "start": 523.69,
    "end": 529.654
  },
  {
    "first": 1060,
    "last": 1068,
    "text": "И настройки клавиши Cine (ретроспективное или проспективное сохранение)",
    "group": 154,
    "start": 529.654,
    "end": 533.783
  },
  {
    "first": 1069,
    "last": 1074,
    "text": "На вкладке биопсия настраивается вид",
    "group": 155,
    "start": 533.783,
    "end": 536.828
  },
  {
    "first": 1075,
    "last": 1084,
    "text": "биопсийной направляющей линии, угол биопсии и биопсийной сетки",
    "group": 156,
    "start": 536.828,
    "end": 541.833
  },
  {
    "first": 1085,
    "last": 1092,
    "text": "На вкладке ”Преднастройки обследования” (Ехат Preset)",
    "group": 157,
    "start": 541.833,
    "end": 546.045
  },
  {
    "first": 1093,
    "last": 1115,
    "text": "Вы можете настроить меню пресетов для каждого датчика",
    "group": 158,
    "start": 546.045,
    "end": 557.557
  },
  {
    "first": 1116,
    "last": 1122,
    "text": "С помощью стрелок вы можете изменить положение иконок пресетов,",
    "group": 159,
    "start": 557.557,
    "end": 561.019
  },
  {
    "first": 1123,
    "last": 1130,
    "text": "посмотреть список доступных пресетов,",
    "group": 160,
    "start": 561.019,
    "end": 564.898
  },
  {
    "first": 1131,
    "last": 1138,
    "text": "добавить необходимые элементы в меню пресетов датчика, а также удалить ненужные",
    "group": 161,
    "start": 564.898,
    "end": 568.777
  },
  {
    "first": 1139,
    "last": 1150,
    "text": "В меню ”Комментарий” две вкладки: ”Инструменты” и ”Список”",
    "group": 162,
    "start": 568.777,
    "end": 574.949
  },
  {
    "first": 1151,
    "last": 1161,
    "text": "На вкладке ”Инструменты” можно настроить параметры аннотаций",
    "group": 163,
    "start": 574.949,
    "end": 580.663
  },
  {
    "first": 1162,
    "last": 1167,
    "text": "На вкладке ”Список” приведены самые распространенные комментарии",
    "group": 164,
    "start": 580.663,
    "end": 583.666
  },
  {
    "first": 1168,
    "last": 1175,
    "text": "с возможностью добавить пользовательский комментарий.",
    "group": 165,
    "start": 583.666,
    "end": 587.42
  },
  {
    "first": 1176,
    "last": 1181,
    "text": "Для каждого типа исследований можно создать собственный список комментариев.",
    "group": 166,
    "start": 587.42,
    "end": 590.548
  },
  {
    "first": 1182,
    "last": 1193,
    "text": "В меню ”Метка тела” можно создать набор меток",
    "group": 167,
    "start": 590.548,
    "end": 596.471
  },
  {
    "first": 1194,
    "last": 1204,
    "text": "для каждого типа обследования, выбрав необходимые вам",
    "group": 168,
    "start": 596.471,
    "end": 602.227
  },
  {
    "first": 1205,
    "last": 1210,
    "text": "В меню ”Измерения” расположены З вкладки",
    "group": 169,
    "start": 602.227,
    "end": 605.23
  },
  {
    "first": 1211,
    "last": 1215,
    "text": "На вкладке ”Общ.инф”",
    "group": 170,
    "start": 605.23,
    "end": 607.357
  },
  {
    "first": 1216,
    "last": 1223,
    "text": "производятся общие настройки элементов интерфейса измерений",
    "group": 171,
    "start": 607.357,
    "end": 611.361
  },
  {
    "first": 1224,
    "last": 1230,
    "text": "Также можно изменить положение окна результатов измерений",
    "group": 172,
    "start": 611.361,
    "end": 615.198
  },
  {
    "first": 1231,
    "last": 1235,
    "text": "На вкладке ”Приложение” можно настроить",
    "group": 173,
    "start": 615.198,
    "end": 617.367
  },
  {
    "first": 1236,
    "last": 1242,
    "text": "специфичные параметры для разных типов обследований",
    "group": 174,
    "start": 617.367,
    "end": 621.12
  },
  {
    "first": 1243,
    "last": 1250,
    "text": "Например, для акушерских обследований",
    "group": 175,
    "start": 621.12,
    "end": 624.791
  },
  {
    "first": 1251,
    "last": 1260,
    "text": "можно выбрать различные формулы для расчета массы плода",
    "group": 176,
    "start": 624.791,
    "end": 629.963
  },
  {
    "first": 1261,
    "last": 1264,
    "text": "На вкладке ”Список” для каждого типа обследования",
    "group": 177,
    "start": 629.963,
    "end": 632.173
  },
  {
    "first": 1265,
    "last": 1275,
    "text": "в каждом режиме пользователь может настроить состав",
    "group": 178,
    "start": 632.173,
    "end": 637.595
  },
  {
    "first": 1276,
    "last": 1288,
    "text": "и порядок отображения элементов и результатов измерений",
    "group": 179,
    "start": 637.595,
    "end": 643.768
  },
  {
    "first": 1289,
    "last": 1297,
    "text": "В меню ”Отчет” редактируются параметры отчета",
    "group": 180,
    "start": 643.768,
    "end": 648.398
  },
  {
    "first": 1298,
    "last": 1309,
    "text": "настраиваются поля отчета, заголовки и т.п.",
    "group": 181,
    "start": 648.398,
    "end": 654.362
  },
  {
    "first": 1310,
    "last": 1326,
    "text": "Формат и размер логотипа должны быть только такими, как предлагает система",
    "group": 182,
    "start": 654.362,
    "end": 663.037
  },
  {
    "first": 1327,
    "last": 1336,
    "text": "В меню ”Периферийные устройства” на вкладке ”Основные”",
    "group": 183,
    "start": 663.037,
    "end": 667.876
  },
  {
    "first": 1337,
    "last": 1346,
    "text": "настраиваются параметры вывода видео, принтеров и ножной педали",
    "group": 184,
    "start": 667.876,
    "end": 673.006
  },
  {
    "first": 1347,
    "last": 1350,
    "text": "Вкладка ”Сеть” предназначена для настройки параметров",
    "group": 185,
    "start": 673.006,
    "end": 675.216
  },
  {
    "first": 1351,
    "last": 1355,
    "text": "сетевого подключения и беспроводной сети",
    "group": 186,
    "start": 675.216,
    "end": 677.343
  },
  {
    "first": 1356,
    "last": 1377,
    "text": "На вкладке DICOM настраиваются параметры сети DICOM",
    "group": 187,
    "start": 677.343,
    "end": 688.313
  },
  {
    "first": 1378,
    "last": 1396,
    "text": "настроить параметры сервера DICOM и локальные настройки DICOM",
    "group": 188,
    "start": 688.313,
    "end": 697.822
  },
  {
    "first": 1397,
    "last": 1405,
    "text": "В меню ”Справка” находится электронная версия руководства по эксплуатации",
    "group": 189,
    "start": 697.822,
    "end": 702.577
  },
  {
    "first": 1406,
    "last": 1422,
    "text": "Меню ”Загрузка значений по умолчанию” предназначено для загрузки,",
    "group": 190,
    "start": 702.577,
    "end": 711.211
  },
  {
    "first": 1423,
    "last": 1440,
    "text": "создания, импорта/экспорта настроек системы.",
    "group": 191,
    "start": 711.211,
    "end": 720.053
  },
  {
    "first": 1441,
    "last": 1452,
    "text": "Меню User Security предназначено для настройки",
    "group": 192,
    "start": 720.053,
    "end": 726.059
  },
  {
    "first": 1453,
    "last": 1463,
    "text": "контроля доступа пользователей к системе",
    "group": 193,
    "start": 726.059,
    "end": 731.481
  },
  {
    "first": 1464,
    "last": 1469,
    "text": "В меню ”Информация” представлена информация о системе",
    "group": 194,
    "start": 731.481,
    "end": 734.567
  },
  {
    "first": 1470,
    "last": 1474,
    "text": "и версии установленного ПО",
    "group": 195,
    "start": 734.567,
    "end": 737.111
  },
  {
    "first": 1475,
    "last": 1478,
    "text": "Данная информация используется",
    "group": 196,
    "start": 737.111,
    "end": 738.78
  },
  {
    "first": 1479,
    "last": 1481,
    "text": "в ходе сервисного обслуживания системы",
    "group": 197,
    "start": 738.78,
    "end": 740.448
  },
  {
    "first": 1482,
    "last": 1487,
