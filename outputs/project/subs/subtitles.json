[
  {
    "id": 1,
    "start": 4.963,
    "end": 11.678,
    "duration": 6.715,
    "text": "Одна из самых популярных линеек SonoScape"
  },
  {
    "id": 2,
    "start": 11.678,
    "end": 14.348,
    "duration": 2.67,
    "text": "Компактный и стильный"
  },
  {
    "id": 3,
    "start": 14.348,
    "end": 17.809,
    "duration": 3.461,
    "text": "Легкий и удобный в транспортировке"
  },
  {
    "id": 4,
    "start": 17.809,
    "end": 24.524,
    "duration": 6.715,
    "text": "От 2 до 3 портов в зависимости модели"
  },
  {
    "id": 5,
    "start": 24.524,
    "end": 28.362,
    "duration": 3.838,
    "text": "Модель E3 оснащена 3 портами"
  },
  {
    "id": 6,
    "start": 28.946,
    "end": 32.491,
    "duration": 3.545,
    "text": "Все интерфейсы (порты ввода/вывода) на борту"
  },
  {
    "id": 7,
    "start": 32.491,
    "end": 38.121,
    "duration": 5.63,
    "text": "Открывается простым движением"
  },
  {
    "id": 8,
    "start": 38.121,
    "end": 43.001,
    "duration": 4.88,
    "text": "Регулируемый угол наклона дисплея"
  },
  {
    "id": 9,
    "start": 45.963,
    "end": 50.467,
    "duration": 4.504,
    "text": "Нажмите кнопку <Patient>"
  },
  {
    "id": 10,
    "start": 50.467,
    "end": 53.053,
    "duration": 2.586,
    "text": "Введите данные нового пациента"
  },
  {
    "id": 11,
    "start": 53.053,
    "end": 57.099,
    "duration": 4.046,
    "text": "ID-пациента можно создать вручную или автоматически"
  },
  {
    "id": 12,
    "start": 57.099,
    "end": 59.226,
    "duration": 2.127,
    "text": "Затем выберите тип исследования"
  },
  {
    "id": 13,
    "start": 59.226,
    "end": 61.061,
    "duration": 1.835,
    "text": "(абдоминальное/кардиология/и др.)"
  },
  {
    "id": 14,
    "start": 61.061,
    "end": 62.938,
    "duration": 1.877,
    "text": "И заполните информацию об исследовании"
  },
  {
    "id": 15,
    "start": 62.938,
    "end": 65.691,
    "duration": 2.753,
    "text": "Также можно выбрать пациента из «списка пациентов»"
  },
  {
    "id": 16,
    "start": 65.691,
    "end": 69.236,
    "duration": 3.545,
    "text": "или из рабочего списка DICOM"
  },
  {
    "id": 17,
    "start": 69.236,
    "end": 71.405,
    "duration": 2.169,
    "text": "После ввода информации о пациенте"
  },
  {
    "id": 18,
    "start": 71.405,
    "end": 75.117,
    "duration": 3.712,
    "text": "Мы начинаем обследование"
  },
  {
    "id": 19,
    "start": 75.117,
    "end": 80.581,
    "duration": 5.464,
    "text": "Например, выбираем предустановку \"щитовидная железа\""
  },
  {
    "id": 20,
    "start": 80.581,
    "end": 83.417,
    "duration": 2.836,
    "text": "И переходим в B-режим"
  },
  {
    "id": 21,
    "start": 83.417,
    "end": 86.128,
    "duration": 2.711,
    "text": "Область изображения отображается посередине"
  },
  {
    "id": 22,
    "start": 86.128,
    "end": 89.631,
    "duration": 3.503,
    "text": "Настройки параметров расположены внизу"
  },
  {
    "id": 23,
    "start": 89.631,
    "end": 92.551,
    "duration": 2.92,
    "text": "Мы можем повернуть регулятор для настройки"
  },
  {
    "id": 24,
    "start": 92.551,
    "end": 95.012,
    "duration": 2.461,
    "text": "Или нажать кнопку для смены регулируемого параметра"
  },
  {
    "id": 25,
    "start": 95.012,
    "end": 99.766,
    "duration": 4.754,
    "text": "И нажать <Next> для перехода на 2ю страницу параметров"
  },
  {
    "id": 26,
    "start": 99.766,
    "end": 103.77,
    "duration": 4.004,
    "text": "Рассмотрим основные параметры B-режима"
  },
  {
    "id": 27,
    "start": 103.77,
    "end": 105.856,
    "duration": 2.086,
    "text": "Включая <Gain> (\"Усиление\")"
  },
  {
    "id": 28,
    "start": 105.856,
    "end": 109.359,
    "duration": 3.503,
    "text": "Увеличивает или уменьшает яркость изображения"
  },
  {
    "id": 29,
    "start": 109.359,
    "end": 110.986,
    "duration": 1.627,
    "text": "Частота"
  },
  {
    "id": 30,
    "start": 110.986,
    "end": 113.113,
    "duration": 2.127,
    "text": "Больше частота — выше разрешение"
  },
  {
    "id": 31,
    "start": 113.113,
    "end": 116.033,
    "duration": 2.92,
    "text": "Ниже частота — лучше проникновение"
  },
  {
    "id": 32,
    "start": 116.033,
    "end": 120.579,
    "duration": 4.546,
    "text": "μ-Scan\nПодавление зернистости и подчеркивание контуров структур"
  },
  {
    "id": 33,
    "start": 120.579,
    "end": 122.539,
    "duration": 1.96,
    "text": "\"Карты серого\""
  },
  {
    "id": 34,
    "start": 122.539,
    "end": 125.083,
    "duration": 2.544,
    "text": "Различные уровни яркости серого"
  },
  {
    "id": 35,
    "start": 125.083,
    "end": 126.293,
    "duration": 1.21,
    "text": "Динамический диапазон"
  },
  {
    "id": 36,
    "start": 126.293,
    "end": 128.378,
    "duration": 2.085,
    "text": "Высокий для большей детализации"
  },
  {
    "id": 37,
    "start": 128.378,
    "end": 131.256,
    "duration": 2.878,
    "text": "Низкий для большей контрастности"
  },
  {
    "id": 38,
    "start": 131.256,
    "end": 132.341,
    "duration": 1.085,
    "text": "Chroma"
  },
  {
    "id": 39,
    "start": 132.341,
    "end": 134.176,
    "duration": 1.835,
    "text": "Псевдоколоризация"
  },
  {
    "id": 40,
    "start": 134.176,
    "end": 137.22,
    "duration": 3.044,
    "text": "И другие основные кнопки параметров"
  },
  {
    "id": 41,
    "start": 137.22,
    "end": 140.14,
    "duration": 2.92,
    "text": "Такие как <depth> (\"глубина\"), <focus> (\"фокус\"), <zoom> (\"увеличение\")"
  },
  {
    "id": 42,
    "start": 140.14,
    "end": 142.893,
    "duration": 2.753,
    "text": "Также доступны на панели управления"
  },
  {
    "id": 43,
    "start": 142.893,
    "end": 146.313,
    "duration": 3.42,
    "text": "Для быстрой и легкой регулировки"
  },
  {
    "id": 44,
    "start": 146.313,
    "end": 149.691,
    "duration": 3.378,
    "text": "Есть 3 способа увеличения изображения"
  },
  {
    "id": 45,
    "start": 149.691,
    "end": 152.611,
    "duration": 2.92,
    "text": "Поверните ручку \"Zoom\" для увеличения изображения"
  },
  {
    "id": 46,
    "start": 152.611,
    "end": 155.28,
    "duration": 2.669,
    "text": "Нажмите кнопку \"Zoom\" для увеличения определенной области"
  },
  {
    "id": 47,
    "start": 155.28,
    "end": 158.992,
    "duration": 3.712,
    "text": "Или нажмите кнопку <z> для полноэкранного изображения"
  },
  {
    "id": 48,
    "start": 159.743,
    "end": 163.872,
    "duration": 4.129,
    "text": "Получив изображение с необходимыми параметрами"
  },
  {
    "id": 49,
    "start": 163.872,
    "end": 166.583,
    "duration": 2.711,
    "text": "Нажмите Freeze для перехода в режим кинопетли"
  },
  {
    "id": 50,
    "start": 166.583,
    "end": 169.503,
    "duration": 2.92,
    "text": "Вращайте трекбол для выбора оптимального кадра"
  },
  {
    "id": 51,
    "start": 169.503,
    "end": 173.048,
    "duration": 3.545,
    "text": "Внизу здесь также отображаются соответствующие параметры"
  },
  {
    "id": 52,
    "start": 173.048,
    "end": 177.928,
    "duration": 4.88,
    "text": "Которые вы можете настроить"
  },
  {
    "id": 53,
    "start": 179.513,
    "end": 183.684,
    "duration": 4.171,
    "text": "Нажмите кнопку <CFM>"
  },
  {
    "id": 54,
    "start": 183.684,
    "end": 186.812,
    "duration": 3.128,
    "text": "Чтобы включить режим ЦДК"
  },
  {
    "id": 55,
    "start": 186.812,
    "end": 188.897,
    "duration": 2.085,
    "text": "Также вы можете включить режим SR Flow"
  },
  {
    "id": 56,
    "start": 188.897,
    "end": 197.364,
    "duration": 8.467,
    "text": "Для улучшения определения низкоскоростного кровотока"
  },
  {
    "id": 57,
    "start": 197.364,
    "end": 205.205,
    "duration": 7.841,
    "text": "В режиме ЦДК на экране появляется рамка"
  },
  {
    "id": 58,
    "start": 205.205,
    "end": 208.041,
    "duration": 2.836,
    "text": "Перемещайте рамку трекболом"
  },
  {
    "id": 59,
    "start": 208.041,
    "end": 220.762,
    "duration": 12.721,
    "text": "Нажмите SET и перемещайте трекбол для изменения размера рамки"
  },
  {
    "id": 60,
    "start": 220.762,
    "end": 224.474,
    "duration": 3.712,
    "text": "Чтобы зафиксировать размер рамки нажмите SET еще раз"
  },
  {
    "id": 61,
    "start": 224.474,
    "end": 227.894,
    "duration": 3.42,
    "text": "соответствующие параметры режима ЦДК отображаются внизу"
  },
  {
    "id": 62,
    "start": 227.894,
    "end": 231.481,
    "duration": 3.587,
    "text": "Параметры регулируются тем же способом"
  },
  {
    "id": 63,
    "start": 231.481,
    "end": 235.736,
    "duration": 4.255,
    "text": "Нажмите <PW> для включения режима импульсно-волнового допплера"
  },
  {
    "id": 64,
    "start": 235.736,
    "end": 239.698,
    "duration": 3.962,
    "text": "Он доступен в B-режиме или ЦДК"
  },
  {
    "id": 65,
    "start": 239.698,
    "end": 243.577,
    "duration": 3.879,
    "text": "Контрольный объем появляется в центре изображения"
  },
  {
    "id": 66,
    "start": 243.577,
    "end": 246.872,
    "duration": 3.295,
    "text": "Используйте трекбол для перемещения контрольного объема в нужную позицию"
  },
  {
    "id": 67,
    "start": 246.872,
    "end": 250.625,
    "duration": 3.753,
    "text": "Для изменения размера нажмите SET"
  },
  {
    "id": 68,
    "start": 250.625,
    "end": 257.215,
    "duration": 6.59,
    "text": "перемещайте трекбол чтобы изменить размер контрольного объема"
  },
  {
    "id": 69,
    "start": 257.215,
    "end": 261.511,
    "duration": 4.296,
    "text": "Нажмите SET еще раз для подтверждения изменений"
  },
  {
    "id": 70,
    "start": 261.511,
    "end": 264.931,
    "duration": 3.42,
    "text": "Затем нажмите <UPDATE> для активации режима PW"
  },
  {
    "id": 71,
    "start": 264.931,
    "end": 267.184,
    "duration": 2.253,
    "text": "Чтобы скорректировать положение контрольного объема в сосуде, перемещайте трекбол"
  },
  {
    "id": 72,
    "start": 267.184,
    "end": 269.561,
    "duration": 2.377,
    "text": "Аппарат выйдет из режима развертки и перейдёт в «живой» B-режим"
  },
  {
    "id": 73,
    "start": 269.561,
    "end": 271.772,
    "duration": 2.211,
    "text": "и вы можете изменить положение контрольного объема"
  },
  {
    "id": 74,
    "start": 271.772,
    "end": 273.398,
    "duration": 1.626,
    "text": "на изображении в реальном времени."
  },
  {
    "id": 75,
    "start": 273.398,
    "end": 275.108,
    "duration": 1.71,
    "text": "Допплеровский режим при этом останавливается."
  },
  {
    "id": 76,
    "start": 275.108,
    "end": 276.276,
    "duration": 1.168,
    "text": "Когда вы остановите трекбол,"
  },
  {
    "id": 77,
    "start": 276.276,
    "end": 278.028,
    "duration": 1.752,
    "text": "снова автоматически запускается допплеровский спектр."
  },
  {
    "id": 78,
    "start": 278.028,
    "end": 280.572,
    "duration": 2.544,
    "text": "Для запуска триплексного режима нажмите функциональную кнопку \"Одноврем\","
  },
  {
    "id": 79,
    "start": 280.572,
    "end": 283.492,
    "duration": 2.92,
    "text": "чтобы выбрать пункт меню, и затем поверните ручку, чтобы включить режим триплекса"
  },
  {
    "id": 80,
    "start": 283.492,
    "end": 285.619,
    "duration": 2.127,
    "text": "кроме отображаемых внизу параметров режима PW"
  },
  {
    "id": 81,
    "start": 285.619,
    "end": 289.831,
    "duration": 4.212,
    "text": "используйте кнопки <Baseline> и <Scale>"
  },
  {
    "id": 82,
    "start": 289.831,
    "end": 291.166,
    "duration": 1.335,
    "text": "Для регулировки, соответственно, положения базовой линии"
  },
  {
    "id": 83,
    "start": 291.166,
    "end": 292.751,
    "duration": 1.585,
    "text": "и шкалы скоростей допплеровского спектра"
  },
  {
    "id": 84,
    "start": 292.751,
    "end": 294.127,
    "duration": 1.376,
    "text": "Нажмите Freeze"
  },
  {
    "id": 85,
    "start": 294.127,
    "end": 297.672,
    "duration": 3.545,
    "text": "После того как вы получили оптимальный спектр"
  },
  {
    "id": 86,
    "start": 297.672,
    "end": 300.3,
    "duration": 2.628,
    "text": "Для автоматической оптимизации изображения"
  },
  {
    "id": 87,
    "start": 300.3,
    "end": 303.303,
    "duration": 3.003,
    "text": "просто нажмите <Auto>"
  },
  {
    "id": 88,
    "start": 303.303,
    "end": 307.808,
    "duration": 4.505,
    "text": "Это работает B-режиме, ЦДК и PW"
  },
  {
    "id": 89,
    "start": 307.808,
    "end": 313.688,
    "duration": 5.88,
    "text": "это экономит время полной настройки параметров"
  },
  {
    "id": 90,
    "start": 313.688,
    "end": 317.108,
    "duration": 3.42,
    "text": "Аппараты серии Е также оснащены"
  },
  {
    "id": 91,
    "start": 317.108,
    "end": 320.987,
    "duration": 3.879,
    "text": "практичными функциями для эффективной работы"
  },
  {
    "id": 92,
    "start": 320.987,
    "end": 322.906,
    "duration": 1.919,
    "text": "SonoHelp вызывается нажатием кнопки P2\nтакими как SonoHelp"
  },
  {
    "id": 93,
    "start": 322.906,
    "end": 326.326,
    "duration": 3.42,
    "text": "SonoHelp вызывается нажатием кнопки P2\nКоторый даёт вам рекомендации по проведению обследования"
  },
  {
    "id": 94,
    "start": 326.326,
    "end": 328.829,
    "duration": 2.503,
    "text": "SonoHelp - это учебник, показывающий расположение датчика,\nанатомические иллюстрации и стандартные примеры ультразвуковых изображений."
  },
  {
    "id": 95,
    "start": 328.829,
    "end": 331.456,
    "duration": 2.627,
    "text": "В качестве полезного справочника,\nна который могли бы положиться менее опытные клиницисты,"
  },
  {
    "id": 96,
    "start": 331.456,
    "end": 336.211,
    "duration": 4.755,
    "text": "SonoHelp охватывает различные области применения,\nвключая печень, почки, сердце, молочные железы,\nщитовидную железу, акушерство, сосуды и т.д."
  },
  {
    "id": 97,
    "start": 336.211,
    "end": 340.215,
    "duration": 4.004,
    "text": "Вы можете добавить свои комментарии к изображению"
  },
  {
    "id": 98,
    "start": 340.215,
    "end": 343.426,
    "duration": 3.211,
    "text": "Нажатием кнопки Annotation"
  },
  {
    "id": 99,
    "start": 343.426,
    "end": 347.722,
    "duration": 4.296,
    "text": "Или выбрать их из библиотеки аннотаций"
  },
  {
    "id": 100,
    "start": 347.722,
    "end": 352.352,
    "duration": 4.63,
    "text": "Для каждого вида обследования предусмотрена своя библиотека аннотаций"
  },
  {
    "id": 101,
    "start": 352.352,
    "end": 356.523,
    "duration": 4.171,
    "text": "Нажмите кнопку BodyMark и выберите нужную пиктограмму"
  },
  {
    "id": 102,
    "start": 356.523,
    "end": 358.441,
    "duration": 1.918,
    "text": "Поверните регулятор Body Mark"
  },
  {
    "id": 103,
    "start": 358.441,
    "end": 361.069,
    "duration": 2.628,
    "text": "Для изменения угла маркера датчика"
  },
  {
    "id": 104,
    "start": 361.069,
    "end": 365.991,
    "duration": 4.922,
    "text": "И двигайте трекбол чтобы поместить маркер датчика в нужное место"
  },
  {
    "id": 105,
    "start": 365.991,
    "end": 369.119,
    "duration": 3.128,
    "text": "Переходим к измерениям и расчётам"
  },
  {
    "id": 106,
    "start": 369.119,
    "end": 372.163,
    "duration": 3.044,
    "text": "При выборе Caliper для базовых измерений"
  },
  {
    "id": 107,
    "start": 372.163,
    "end": 375.709,
    "duration": 3.546,
    "text": "Список измерений появится в левой части экрана"
  },
  {
    "id": 108,
    "start": 375.709,
    "end": 377.46,
    "duration": 1.751,
    "text": "Щелкните на нужное измерение"
  },
  {
    "id": 109,
    "start": 377.46,
    "end": 380.213,
    "duration": 2.753,
    "text": "измеритель появится в области изображения"
  },
  {
    "id": 110,
    "start": 380.213,
    "end": 381.548,
    "duration": 1.335,
    "text": "трекболом установите курсор и нажмите Set,"
  },
  {
    "id": 111,
    "start": 381.548,
    "end": 383.008,
    "duration": 1.46,
    "text": "на экране появится второй курсор, переместите"
  },
  {
    "id": 112,
    "start": 383.008,
    "end": 384.593,
    "duration": 1.585,
    "text": "второй указатель в желаемое положение, снова нажмите SET"
  },
  {
    "id": 113,
    "start": 384.593,
    "end": 390.932,
    "duration": 6.339,
    "text": "По завершению всех шагов результаты отобразятся в окне результатов измерений"
  },
  {
    "id": 114,
    "start": 390.932,
    "end": 392.559,
    "duration": 1.627,
    "text": "Нажмите клавишу <Calc>"
  },
  {
    "id": 115,
    "start": 392.559,
    "end": 394.603,
    "duration": 2.044,
    "text": "отображаются специальные измерения"
  },
  {
    "id": 116,
    "start": 394.603,
    "end": 396.479,
    "duration": 1.876,
    "text": "и расчёты для каждой области применения."
  },
  {
    "id": 117,
    "start": 396.479,
    "end": 401.943,
    "duration": 5.464,
    "text": "Вы можете выбрать нужное вам исследование"
  },
  {
    "id": 118,
    "start": 411.411,
    "end": 414.873,
    "duration": 3.462,
    "text": "Результаты специальных измерений"
  },
  {
    "id": 119,
    "start": 414.873,
    "end": 418.46,
    "duration": 3.587,
    "text": "попадают в отчет автоматически по их завершению"
  },
  {
    "id": 120,
    "start": 418.46,
    "end": 421.755,
    "duration": 3.295,
    "text": "Получив требуемый кадр и кинопетлю"
  },
  {
    "id": 121,
    "start": 421.755,
    "end": 424.174,
    "duration": 2.419,
    "text": "или закончив работу с аннотациями"
  },
  {
    "id": 122,
    "start": 424.174,
    "end": 426.051,
    "duration": 1.877,
    "text": "маркерами тела и вычислениями"
  },
  {
    "id": 123,
    "start": 426.051,
    "end": 429.638,
    "duration": 3.587,
    "text": "Вы можете нажать клавиши Image или Cine"
  },
  {
    "id": 124,
    "start": 429.638,
    "end": 431.765,
    "duration": 2.127,
    "text": "изображения и кинопетли будут сохранены на жёстком диске аппарата"
  },
  {
    "id": 125,
    "start": 431.765,
    "end": 433.808,
    "duration": 2.043,
    "text": "их миниатюры будут показаны в правой части экрана"
  },
  {
    "id": 126,
    "start": 433.808,
    "end": 436.311,
    "duration": 2.503,
    "text": "Выберите изображение указателем (клавиша Pointer)"
  },
  {
    "id": 127,
    "start": 436.311,
    "end": 438.897,
    "duration": 2.586,
    "text": "Для просмотра и управления им"
  },
  {
    "id": 128,
    "start": 438.897,
    "end": 441.358,
    "duration": 2.461,
    "text": "Щелкнув по этим функциональным элементам"
  },
  {
    "id": 129,
    "start": 441.358,
    "end": 444.194,
    "duration": 2.836,
    "text": "По завершению обследования"
  },
  {
    "id": 130,
    "start": 444.194,
    "end": 446.029,
    "duration": 1.835,
    "text": "Нажмите клавишу Report"
  },
  {
    "id": 131,
    "start": 446.029,
    "end": 448.406,
    "duration": 2.377,
    "text": "для просмотра результатов специальных измерений и расчётов"
  },
  {
    "id": 132,
    "start": 448.406,
    "end": 451.743,
    "duration": 3.337,
    "text": "Нажмите \"Summary\" и введите заключение"
  },
  {
    "id": 133,
    "start": 451.743,
    "end": 459.0,
    "duration": 7.257,
    "text": "Выберите изображения для прикрепления к отчету"
  },
  {
    "id": 134,
    "start": 459.0,
    "end": 462.921,
    "duration": 3.921,
    "text": "Воспользуйтесь предварительным просмотром по завершению"
  },
  {
    "id": 135,
    "start": 462.921,
    "end": 466.091,
    "duration": 3.17,
    "text": "Затем перешлите отчет по DICOM"
  },
  {
    "id": 136,
    "start": 466.091,
    "end": 472.806,
    "duration": 6.715,
    "text": "или нажмите End Exam для сохранения на жестком диске сканера"
  },
  {
    "id": 137,
    "start": 472.806,
    "end": 478.103,
    "duration": 5.297,
    "text": "При нажатии кнопки Setup в левом нижнем углу клавиатуры"
  },
  {
    "id": 138,
    "start": 478.103,
    "end": 481.898,
    "duration": 3.795,
    "text": "Вы переходите в меню настроек аппарата"
  },
  {
    "id": 139,
    "start": 481.898,
    "end": 488.947,
    "duration": 7.049,
    "text": "Настраиваемые параметры отображаются слева"
  },
  {
    "id": 140,
    "start": 488.947,
    "end": 492.075,
    "duration": 3.128,
    "text": "Сперва идут общие настройки системы"
  },
  {
    "id": 141,
    "start": 492.075,
    "end": 494.536,
    "duration": 2.461,
    "text": "Они включают 4 вкладки:"
  },
  {
    "id": 142,
    "start": 494.536,
    "end": 499.791,
    "duration": 5.255,
    "text": "<Общ.инф> <Дисплей> <Сохранить> и <Биопсия>"
  },
  {
    "id": 143,
    "start": 499.791,
    "end": 504.087,
    "duration": 4.296,
    "text": "на вкладке Общ.инф можно настроить поля"
  },
  {
    "id": 144,
    "start": 504.087,
    "end": 508.55,
    "duration": 4.463,
    "text": "такие \"Название клиники\", \"Язык\", \"Время\" и др."
  },
  {
    "id": 145,
    "start": 508.55,
    "end": 512.011,
    "duration": 3.461,
    "text": "на вкладке \"Дисплей\" можно настроить"
  },
  {
    "id": 146,
    "start": 512.011,
    "end": 516.891,
    "duration": 4.88,
    "text": "параметры дисплея по своему усмотрению"
  },
  {
    "id": 147,
    "start": 516.891,
    "end": 523.69,
    "duration": 6.799,
    "text": "вкладка \"Сохранить\" используется для изменения длительности сохраняемой кинопетли"
  },
  {
    "id": 148,
    "start": 523.69,
    "end": 529.654,
    "duration": 5.964,
    "text": "А также для назначения функций настраиваемых клавиш P1 P2 F3 F4"
  },
  {
    "id": 149,
    "start": 529.654,
    "end": 533.783,
    "duration": 4.129,
    "text": "И настройки клавиши Cine (ретроспективное или проспективное сохранение)"
  },
  {
    "id": 150,
    "start": 533.783,
    "end": 536.828,
    "duration": 3.045,
    "text": "На вкладке биопсия настраивается вид"
  },
  {
    "id": 151,
    "start": 536.828,
    "end": 541.833,
    "duration": 5.005,
    "text": "биопсийной направляющей линии, угол биопсии и биопсийной сетки"
  },
  {
    "id": 152,
    "start": 541.833,
    "end": 546.045,
    "duration": 4.212,
    "text": "На вкладке \"Преднастройки обследования\" (Exam Preset)"
  },
  {
    "id": 153,
    "start": 546.045,
    "end": 557.557,
    "duration": 11.512,
    "text": "Вы можете настроить меню пресетов для каждого датчика"
  },
  {
    "id": 154,
    "start": 557.557,
    "end": 561.019,
    "duration": 3.462,
    "text": "С помощью стрелок вы можете изменить положение иконок пресетов,"
  },
  {
    "id": 155,
    "start": 561.019,
    "end": 564.898,
    "duration": 3.879,
    "text": "посмотреть список доступных пресетов,"
  },
  {
    "id": 156,
    "start": 564.898,
    "end": 568.777,
    "duration": 3.879,
    "text": "добавить необходимые элементы в меню пресетов датчика, а также удалить ненужные"
  },
  {
    "id": 157,
    "start": 568.777,
    "end": 574.949,
    "duration": 6.172,
    "text": "В меню \"Комментарий\" две вкладки: \"Инструменты\" и \"Список\""
  },
  {
    "id": 158,
    "start": 574.949,
    "end": 580.663,
    "duration": 5.714,
    "text": "На вкладке \"Инструменты\" можно настроить параметры аннотаций"
  },
  {
    "id": 159,
    "start": 580.663,
    "end": 583.666,
    "duration": 3.003,
    "text": "На вкладке \"Список\" приведены самые распространенные комментарии"
  },
  {
    "id": 160,
    "start": 583.666,
    "end": 587.42,
    "duration": 3.754,
    "text": "с возможностью добавить пользовательский комментарий."
  },
  {
    "id": 161,
    "start": 587.42,
    "end": 590.548,
    "duration": 3.128,
    "text": "Для каждого типа исследований можно создать собственный список комментариев."
  },
  {
    "id": 162,
    "start": 590.548,
    "end": 596.471,
    "duration": 5.923,
    "text": "В меню \"Метка тела\" можно создать набор меток"
  },
  {
    "id": 163,
    "start": 596.471,
    "end": 602.227,
    "duration": 5.756,
    "text": "для каждого типа обследования, выбрав необходимые вам"
  },
  {
    "id": 164,
    "start": 602.227,
    "end": 605.23,
    "duration": 3.003,
    "text": "В меню \"Измерения\" расположены 3 вкладки"
  },
  {
    "id": 165,
    "start": 605.23,
    "end": 607.357,
    "duration": 2.127,
    "text": "На вкладке \"Общ.инф\""
  },
  {
    "id": 166,
    "start": 607.357,
    "end": 611.361,
    "duration": 4.004,
    "text": "производятся общие настройки элементов интерфейса измерений"
  },
  {
    "id": 167,
    "start": 611.361,
    "end": 615.198,
    "duration": 3.837,
    "text": "Также можно изменить положение окна результатов измерений"
  },
  {
    "id": 168,
    "start": 615.198,
    "end": 617.367,
    "duration": 2.169,
    "text": "На вкладке \"Приложение\" можно настроить"
  },
  {
    "id": 169,
    "start": 617.367,
    "end": 621.12,
    "duration": 3.753,
    "text": "специфичные параметры для разных типов обследований"
  },
  {
    "id": 170,
    "start": 621.12,
    "end": 624.791,
    "duration": 3.671,
    "text": "Например, для акушерских обследований"
  },
  {
    "id": 171,
    "start": 624.791,
    "end": 629.963,
    "duration": 5.172,
    "text": "можно выбрать различные формулы для расчета массы плода"
  },
  {
    "id": 172,
    "start": 629.963,
    "end": 632.173,
    "duration": 2.21,
    "text": "На вкладке \"Список\" для каждого типа обследования"
  },
  {
    "id": 173,
    "start": 632.173,
    "end": 637.595,
    "duration": 5.422,
    "text": "в каждом режиме пользователь может настроить состав"
  },
  {
    "id": 174,
    "start": 637.595,
    "end": 643.768,
    "duration": 6.173,
    "text": "и порядок отображения элементов и результатов измерений"
  },
  {
    "id": 175,
    "start": 643.768,
    "end": 648.398,
    "duration": 4.63,
    "text": "В меню \"Отчет\" редактируются параметры отчета"
  },
  {
    "id": 176,
    "start": 648.398,
    "end": 654.362,
    "duration": 5.964,
    "text": "настраиваются поля отчета, заголовки и т.п."
  },
  {
    "id": 177,
    "start": 654.362,
    "end": 663.037,
    "duration": 8.675,
    "text": "Формат и размер логотипа должны быть только такими, как предлагает система"
  },
  {
    "id": 178,
    "start": 663.037,
    "end": 667.876,
    "duration": 4.839,
    "text": "В меню \"Периферийные устройства\" на вкладке \"Основные\""
  },
  {
    "id": 179,
    "start": 667.876,
    "end": 673.006,
    "duration": 5.13,
    "text": "настраиваются параметры вывода видео, принтеров и ножной педали"
  },
  {
    "id": 180,
    "start": 673.006,
    "end": 675.216,
    "duration": 2.21,
    "text": "Вкладка \"Сеть\" предназначена для настройки параметров"
  },
  {
    "id": 181,
    "start": 675.216,
    "end": 677.343,
    "duration": 2.127,
    "text": "сетевого подключения и беспроводной сети"
  },
  {
    "id": 182,
    "start": 677.343,
    "end": 688.313,
    "duration": 10.97,
    "text": "На вкладке DICOM настраиваются параметры сети DICOM"
  },
  {
    "id": 183,
    "start": 688.313,
    "end": 697.822,
    "duration": 9.509,
    "text": "настроить параметры сервера DICOM и локальные настройки DICOM"
  },
  {
    "id": 184,
    "start": 697.822,
    "end": 702.577,
    "duration": 4.755,
    "text": "В меню \"Справка\" находится электронная версия руководства по эксплуатации"
  },
  {
    "id": 185,
    "start": 702.577,
    "end": 711.211,
    "duration": 8.634,
    "text": "Меню \"Загрузка значений по умолчанию\" предназначено для загрузки,"
  },
  {
    "id": 186,
    "start": 711.211,
    "end": 720.053,
    "duration": 8.842,
    "text": "создания, импорта/экспорта настроек системы."
  },
  {
    "id": 187,
    "start": 720.053,
    "end": 726.059,
    "duration": 6.006,
    "text": "Меню User Security предназначено для настройки"
  },
  {
    "id": 188,
    "start": 726.059,
    "end": 731.481,
    "duration": 5.422,
    "text": "контроля доступа пользователей к системе"
  },
  {
    "id": 189,
    "start": 731.481,
    "end": 734.567,
    "duration": 3.086,
    "text": "В меню \"Информация\" представлена информация о системе"
  },
  {
    "id": 190,
    "start": 734.567,
    "end": 737.111,
    "duration": 2.544,
    "text": "и версии установленного ПО"
  },
  {
    "id": 191,
    "start": 737.111,
    "end": 738.78,
    "duration": 1.669,
    "text": "Данная информация используется"
  },
  {
    "id": 192,
    "start": 738.78,
    "end": 740.448,
    "duration": 1.668,
    "text": "в ходе сервисного обслуживания системы"
  },
  {
    "id": 193,
    "start": 740.448,
    "end": 743.493,
    "duration": 3.045,
    "text": "Не забудьте нажать клавишу Apply"
  },
  {
    "id": 194,
    "start": 743.493,
    "end": 745.87,
    "duration": 2.377,
    "text": "для применения изменений"
  },
  {
    "id": 195,
    "start": 746.412,
    "end": 751.96,
    "duration": 5.548,
    "text": "Для выключения нажмите кнопку Power"
  },
  {
    "id": 196,
    "start": 751.96,
    "end": 756.923,
    "duration": 4.963,
    "text": "В появившемся окне вы можете выбрать \"Режим ожидания\""
  },
  {
    "id": 197,
    "start": 756.923,
    "end": 762.303,
    "duration": 5.38,
    "text": "или \"Завершить работу системы\""
  },
  {
    "id": 198,
    "start": 762.303,
    "end": 769.227,
    "duration": 6.924,
    "text": "Также можно отменить выключение"
  }
]